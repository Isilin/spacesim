# Toolchain e2e (chantier 5.3) : étend le Dockerfile de base avec les dépendances
# système de Chromium, pour ne pas alourdir les services app/test/typecheck avec
# les libs navigateur (~300 Mo). Le binaire Chromium lui-même s'installe au premier
# `docker compose run e2e` (mis en cache dans le volume nommé playwright_browsers).
FROM node:26-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ ca-certificates \
  && rm -rf /var/lib/apt/lists/*

# Node 26 ne livre plus corepack (voir Dockerfile) : il s'installe depuis npm.
RUN npm install -g corepack@latest && corepack enable

WORKDIR /app

# La version est LUE dans apps/web/package.json, jamais recopiée ici : elle y était
# écrite deux fois, et rien ne vérifiait l'accord. Un bump Dependabot de
# @playwright/test désynchronisait donc les dépendances système en silence — la CI
# GitHub ne s'en aperçoit pas, elle installe via `playwright install --with-deps`.
# Copier ce seul manifeste garde le cache de couche : il n'est invalidé que quand
# apps/web change de dépendances.
COPY apps/web/package.json /tmp/web-package.json
RUN PLAYWRIGHT_VERSION="$(node -p "require('/tmp/web-package.json').devDependencies['@playwright/test']")" \
  && npx -y "playwright@${PLAYWRIGHT_VERSION}" install-deps chromium \
  && rm /tmp/web-package.json
