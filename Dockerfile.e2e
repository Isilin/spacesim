# Toolchain e2e (chantier 5.3) : étend le Dockerfile de base avec les dépendances
# système de Chromium, pour ne pas alourdir les services app/test/typecheck avec
# les libs navigateur (~300 Mo). Le binaire Chromium lui-même s'installe au premier
# `docker compose run e2e` (mis en cache dans le volume nommé playwright_browsers).
FROM node:22-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ ca-certificates \
  && rm -rf /var/lib/apt/lists/*

RUN corepack enable

WORKDIR /app

# Version alignée sur @playwright/test dans apps/web/package.json — à mettre à
# jour ensemble si l'une des deux change.
RUN npx -y playwright@1.62.1 install-deps chromium
