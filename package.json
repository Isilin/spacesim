{
  "name": "spacesim",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev:server": "pnpm --filter @spacesim/server dev",
    "dev:web": "pnpm --filter @spacesim/web dev",
    "dev:admin": "pnpm --filter @spacesim/admin dev",
    "test": "vp test",
    "bench": "vp test bench --project @spacesim/server",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "typescript": "catalog:",
    "vite-plus": "^0.3.1"
  }
}
