{
  "name": "spacesim",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "vp run -r --parallel dev",
    "dev:server": "vp run -F @spacesim/server dev",
    "dev:web": "vp run -F @spacesim/web dev",
    "dev:admin": "vp run -F @spacesim/admin dev",
    "test": "vp test",
    "bench": "vp test bench --project @spacesim/server",
    "check": "vp check",
    "typecheck": "vp check --no-fmt --no-lint",
    "lint": "vp lint",
    "format": "vp fmt",
    "format:check": "vp fmt --check"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vite-plus": "^0.3.1"
  }
}
